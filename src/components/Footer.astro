---
import { NAV, SITE } from '../data/site';
import { CORE_SOURCES } from '../data/sources';

const year = new Date().getFullYear();
const trustLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Privacy Policy', href: '/privacy-policy/' },
  { label: 'Terms', href: '/terms/' },
  { label: 'Editorial policy', href: '/editorial-policy/' },
  { label: 'Sitemap', href: '/sitemap-index.xml' },
] as const;
---

<footer class="border-t border-white/10 bg-soil">
  <div class="container py-12">
    <div class="grid gap-8 md:grid-cols-[1.25fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-md border border-accent/30 bg-accent/10 text-sm font-black text-accent">
            {SITE.shortName}
          </span>
          <div>
            <p class="text-sm font-black uppercase text-bone">{SITE.name}</p>
            <p class="text-xs font-semibold uppercase text-fog">{SITE.tagline}</p>
          </div>
        </div>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-fog">
          Independent fan guide for {SITE.gameName}. Practical shop and dungeon guides, with advice distinguished from documented game facts.
        </p>
      </div>

      <nav aria-label="Guide links">
        <p class="text-xs font-black uppercase text-bone">Guides</p>
        <ul class="mt-3 space-y-2">
          {NAV.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-fog hover:text-wheat">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Official links">
        <p class="text-xs font-black uppercase text-bone">Official sources</p>
        <ul class="mt-3 space-y-2">
          {CORE_SOURCES.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="nofollow noopener noreferrer" class="text-sm text-fog hover:text-wheat">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Site links">
        <p class="text-xs font-black uppercase text-bone">Site</p>
        <ul class="mt-3 space-y-2">
          {trustLinks.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-fog hover:text-wheat">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-xs leading-relaxed text-fog">
      <p>
        This site is not affiliated with or endorsed by {SITE.developer} or {SITE.publisher}. {SITE.gameName}, screenshots, names, and trademarks belong to their respective owners.
      </p>
      <p class="mt-2">
        Read our <a href="/editorial-policy/" class="underline">editorial policy</a> or contact:
        <a href={`mailto:${SITE.contactEmail}`} class="text-wheat underline underline-offset-2">{SITE.contactEmail}</a>.
      </p>
      <p class="mt-2">&copy; {year} {SITE.name}.</p>
    </div>
  </div>
</footer>
