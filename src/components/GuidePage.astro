---
import Layout from '../layouts/Layout.astro';
import SourcePanel from './SourcePanel.astro';
import { getPageAsset } from '../data/assets';
import { CORE_SOURCES } from '../data/sources';
import type { SourceRef } from '../data/sources';
import { SITE, type PageData } from '../data/site';

interface Props {
  page: PageData;
}

const { page } = Astro.props;
const pageAsset = getPageAsset(page.slug);
const sourceList: readonly SourceRef[] = page.sources ?? CORE_SOURCES;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: page.title, url: '/' + page.slug + '/' },
];
const statusClass = page.status === 'Verified'
  ? 'border-sage/40 bg-sage/10 text-sage'
  : page.status === 'Launch-day update'
    ? 'border-accent/40 bg-accent/10 text-accent'
    : 'border-white/20 bg-white/5 text-fog';
---

<Layout title={page.title + ' | ' + SITE.name} description={page.description} pageType="article" image={pageAsset.src} breadcrumbs={breadcrumbs}>
  <article class="mx-auto max-w-4xl">
    <div class="flex flex-wrap items-center gap-3">
      <p class="section-kicker">{page.kicker}</p>
      <span class:list={['rounded-full border px-3 py-1 text-xs font-black uppercase', statusClass]}>{page.status}</span>
    </div>
    <h1 class="mt-3 text-4xl font-black leading-tight text-bone md:text-5xl">{page.title}</h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-fog">{page.intro}</p>

    <div class="mt-8 overflow-hidden rounded-md border border-white/10">
      <img src={pageAsset.src} alt={pageAsset.alt} width={pageAsset.width} height={pageAsset.height} class="h-56 w-full object-cover md:h-72" loading="eager" />
      <p class="border-t border-white/10 bg-soil px-4 py-3 text-xs text-fog">{pageAsset.credit}. This image is used for identification and editorial context.</p>
    </div>

    <div class="prose-page mt-10">
      {page.sections.map((section) => (
        <section class="border-t border-white/10 pt-8">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
          {section.note && (
            <div class="surface-muted mt-5 p-4">
              <p class="!mt-0 text-xs font-black uppercase text-accent">{section.note.label}</p>
              <p class="text-sm text-fog">{section.note.text}</p>
            </div>
          )}
        </section>
      ))}
      {page.table && (
        <section class="border-t border-white/10 pt-8">
          <h2>{page.table.heading}</h2>
          <div class="mt-4 overflow-x-auto rounded-md border border-white/10">
            <table class="min-w-full text-sm">
              <thead class="bg-moss/25 text-left text-bone">
                <tr>{page.table.headers.map((header) => <th class="px-4 py-3">{header}</th>)}</tr>
              </thead>
              <tbody>
                {page.table.rows.map((row) => (
                  <tr class="border-t border-white/10 align-top">
                    {row.map((cell) => <td class="px-4 py-3 text-fog">{cell}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}
      {page.relatedPages && (
        <section class="border-t border-white/10 pt-8">
          <h2>Related Moonlighter 2 guides</h2>
          <div class="mt-4 grid gap-4 md:grid-cols-3">
            {page.relatedPages.map((related) => (
              <a href={related.href} class="surface-muted block p-4 transition hover:border-accent/50">
                <h3 class="font-black text-bone">{related.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-fog">{related.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <SourcePanel sources={sourceList} />
  </article>
</Layout>
