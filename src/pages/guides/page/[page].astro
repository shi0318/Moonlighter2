---
import GuideCard from '../../../components/GuideCard.astro';
import Pagination from '../../../components/Pagination.astro';
import Layout from '../../../layouts/Layout.astro';
import { ASSETS } from '../../../data/assets';
import { REQUIRED_GUIDES, SITE } from '../../../data/site';

const orderedGuides = [...REQUIRED_GUIDES];
const PAGE_SIZE = 9;
export function getStaticPaths() {
  const PAGE_SIZE = 9;
  const orderedGuides = [...REQUIRED_GUIDES];
  const totalPages = Math.ceil(orderedGuides.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => { const page = i + 2; return { params: { page: String(page) }, props: { page, totalPages } }; });
}
const { page, totalPages } = Astro.props;
const visibleGuides = orderedGuides.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const title = `Moonlighter 2 Guide Hub — Page ${page}`;
const description = 'More Moonlighter 2 guides, kept in the maintained newest-first editorial order.';
---
<Layout title={title} description={description} pageType="collection">
  <header class="mb-10"><p class="section-kicker">Guide directory</p><h1 class="section-title">Moonlighter 2 guides — page {page}</h1><p class="mt-4 max-w-3xl text-lg leading-relaxed text-fog">Page {page} of {totalPages}; the newest maintained entries appear first.</p></header>
  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{visibleGuides.map((guide) => <GuideCard href={guide.href} title={guide.title} description={guide.description} label={guide.priority} image={ASSETS[guide.image]} />)}</div>
  <Pagination currentPage={page} totalPages={totalPages} basePath="/guides/" />
</Layout>
